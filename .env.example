# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Tag Manager (container ID, e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Session timeout in seconds (default: 2592000 = 30 days)
# AUTH_SESSION_MAX_AGE=2592000

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=TeamUp <noreply@teamup.ar>

# Mercado Pago (Checkout Pro) — https://www.mercadopago.com.ar/developers
# Access token of the TeamUp account, the single collector in the platform: it
# is what charges each organization the service fee of the tournaments it
# played. Organizers do not connect anything (entry fees are settled between
# player and organizer off-platform). A TEST-… token routes checkouts to the
# sandbox automatically.
MP_ACCESS_TOKEN=APP_USR-...
# Optional: secret to validate the x-signature header of incoming webhooks.
# MP_WEBHOOK_SECRET=your-webhook-secret

# Database (NeORM resolves the data source from these variables)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teamup
DB_USERNAME=postgres
DB_PASSWORD=postgres
